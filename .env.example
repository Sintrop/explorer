EXPLORER_TITLE="BLCK Explorer"
NEXT_PUBLIC_RPC_URL="http://localhost:8545"
NEXT_PUBLIC_EXPLORER_TITLE="BLCK Explorer"
NEXT_PUBLIC_LOGO_HEADER_URL="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_COIN_NAME="ETH"
NEXT_PUBLIC_NETWORK_NAME="ETH"
NEXT_PUBLIC_NETWORK_ID=1
NEXT_PUBLIC_NETWORK_RPC="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_NETWORK_EXPLORER="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SEO_TITLE="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SEO_DESCRIPTION="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_TESTNET=true
# Polling interval in ms for live data (latest block, pending txs). Default: 12000
NEXT_PUBLIC_REFETCH_INTERVAL=12000

# Known contracts registry in config/contracts (labels, ABI decoding, token pages). Leave empty for none.
# Generate with: node scripts/sync-contracts.mjs <core-contracts> <deployment> <name>
NEXT_PUBLIC_CONTRACTS="sintrop-mainnet"

# Network page (/network)
# Current block reward and an optional upcoming reward change (e.g. ECIP-1017 era reduction)
NEXT_PUBLIC_BLOCK_REWARD=5
NEXT_PUBLIC_UPCOMING_FORK_BLOCK=5000000
NEXT_PUBLIC_UPCOMING_BLOCK_REWARD=4
NEXT_PUBLIC_REWARD_ERA_BLOCKS=5000000
# Server-only list of nodes to monitor. "rpc" is queried for client/height/peers;
# "host" + "p2pPort" is checked with a TCP connection. Neither URL is sent to the browser.
# "name" can be a string or one name per locale.
NETWORK_NODES='[{"name":{"pt":"RPC público","en":"Public RPC"},"rpc":"https://rpc.example.org"},{"name":"Bootnode 1","host":"203.0.113.10","p2pPort":30303}]'
